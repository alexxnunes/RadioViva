        "title": "Exibir",
        "type": "boolean",
        "default": true
      },
      {
        "id": "name",
        "title": "Nome da Rádio",
        "type": "string"
      },
      {
        "id": "url",
        "title": "URL do Stream",
        "type": "string"
      }
    ],
