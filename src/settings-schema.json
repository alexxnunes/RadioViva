  "radio-search-widget": {
    "type": "custom",
    "file": "RadioSearchWidget.py",
    "widget": "RadioSearchWidget"
  },
  "show-station-on-panel": {
    "type": "checkbox",
    "default": false,
    "description": "Exibir nome da rádio na barra de tarefas",
    "tooltip": "Mostra o nome da rádio ou a faixa tocando ao lado do ícone no painel"
  },
  "panel-text-type": {
    "type": "radiogroup",
    "default": "station",
    "description": "Conteúdo exibido na barra",
    "options": {
      "Apenas o Nome da Estação": "station",
      "Nome da Música / Programa": "track",
      "Estação + Música": "both"
    },
    "dependency": "show-station-on-panel"
  },
  "max-panel-text-length": {
    "type": "spinbutton",
    "default": 24,
    "min": 10,
    "max": 60,
    "step": 2,
    "units": "caracteres",
    "description": "Limite de caracteres na barra",
    "dependency": "show-station-on-panel"
  },
  "show-notifications": {
    "type": "checkbox",
    "default": true,
    "description": "Notificar quando a rádio ou música mudar"
  },
  "initial-volume": {
    "type": "spinbutton",
    "default": 80,
    "min": 0,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Volume inicial padrão"
  },
  "keep-volume-between-sessions": {
    "type": "checkbox",
    "default": true,
    "description": "Lembrar o último volume utilizado"
  },
  "record-directory": {
    "type": "entry",
    "default": "~/Música/RadioViva",
    "description": "Pasta de destino das gravações MP3"
  }
}
