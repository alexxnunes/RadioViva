{
  "layout": {
    "type": "layout",
    "pages": [
      "page-my-stations",
      "page-search",
      "page-general"
    ],
    "page-my-stations": {
      "type": "page",
      "title": "Minhas Rádios",
      "sections": [
        "sec-my-stations"
      ]
    },
    "page-search": {
      "type": "page",
      "title": "Buscar no Brasil (+1.300 Rádios)",
      "sections": [
        "sec-search"
      ]
    },
    "page-general": {
      "type": "page",
      "title": "Preferências Gerais",
      "sections": [
        "sec-appearance",
        "sec-playback"
      ]
    },
    "sec-my-stations": {
      "type": "section",
      "title": "Rádios no Painel (Adicione, Edite ou Reordene)",
      "keys": [
        "user-stations"
      ]
    },
    "sec-search": {
      "type": "section",
      "title": "Pesquisar Rádios Brasileiras e Adicionar",
      "keys": [
        "radio-search-widget"
      ]
    },
    "sec-appearance": {
      "type": "section",
      "title": "Exibição na Barra de Tarefas",
      "keys": [
        "show-station-on-panel",
        "panel-text-type",
        "max-panel-text-length"
      ]
    },
    "sec-playback": {
      "type": "section",
      "title": "Áudio e Notificações",
      "keys": [
        "initial-volume",
        "keep-volume-between-sessions",
        "show-notifications",
        "record-directory"
      ]
    }
  },
  "user-stations": {
    "type": "list",
    "height": 450,
    "columns": [
      {
